{
  // Archive deployment of the original bugmilkshakes.org site, served at
  // old.antmalts.me. Cloudflare Workers with static assets (not Pages).
  //
  // The presence of this file with `main` + `assets` is what makes
  // @sveltejs/adapter-cloudflare emit Workers output instead of Pages output;
  // without it the build falls back to Pages and writes a _routes.json.
  //
  // Build command: npm run build
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "old-antmalts-me",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-06",
  // Required by SvelteKit's server runtime on Workers.
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
